# Server
PORT=5000
NODE_ENV=development
# Must match the Vite dev server port (vite.config.ts server.port=5173)
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/campus_placement

# JWT
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=30d

# Mail (Nodemailer - example using Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Campus Placement <no-reply@campusplacement.com>"

# Cloudinary (optional, for cloud file storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload
MAX_FILE_SIZE_MB=5


# AI Microservice (Python/FastAPI, ai-service/)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000
