# ==============================================================================
# Environment Configuration Template
# Copy this file to `.env` and fill in real values before running the service.
# ==============================================================================

# --- Application ---
APP_NAME="AI-Powered Smart Internship & Job Recommendation Portal"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- CORS (comma separated list of allowed origins, or * for all) ---
CORS_ORIGINS=*

# --- MongoDB (used to optionally persist parsed resumes / rankings) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_job_portal

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
