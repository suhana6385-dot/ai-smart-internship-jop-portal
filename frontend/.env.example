# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file — only this template.

# Base URL of the main backend REST API. AI-flavored features (resume
# analysis, skill gap, career/job/internship recommendations, etc.) are
# also reached through this same backend, at ${VITE_API_BASE_URL}/ai/* —
# there is no separate AI service URL to configure on the frontend.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Display name used in the browser tab title and a few UI strings
VITE_APP_NAME=AI Smart Internship & Job Recommendation Portal
